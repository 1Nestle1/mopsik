<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- self contained publishing downloads the .NET runtime pack, and a machine may have no
       package source set up at all -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
