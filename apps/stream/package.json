{
  "name": "@sharkord/stream",
  "productName": "MOPSCORD Stream",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Stream a screen or a window, with its sound, into a MOPSCORD voice channel",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "bun build src/main/index.ts --outfile dist-electron/main.cjs --target node --format cjs --external electron && bun build src/preload/index.ts --outfile dist-electron/preload.cjs --target node --format cjs --external electron",
    "build:audio": "dotnet publish native/AppAudio/AppAudio.csproj -c Release -r win-x64 -o resources/app-audio",
    "build": "bun run build:renderer && bun run build:electron",
    "start": "bun run build && electron .",
    "dist": "bun run build:audio && bun run build && electron-builder --win",
    "test": "bun test",
    "lint": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "format": "prettier --write \"src/**/*.ts*\" --config ./.prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts*\" --config ./.prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@sharkord/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.4.0",
    "lucide-react": "^0.544.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "app.mopscord.stream",
    "productName": "MOPSCORD Stream",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist-renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-audio",
        "to": "app-audio",
        "filter": [
          "AppAudio.exe"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "../client/public/icon-512.png"
    },
    "portable": {
      "artifactName": "MOPSCORD-Stream-${version}.exe"
    }
  }
}
